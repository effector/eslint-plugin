{
  "name": "eslint-plugin-effector",
  "version": "0.19.0",
  "description": "Enforcing best practices for Effector",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "effector"
  ],
  "homepage": "https://eslint.effector.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effector/eslint-plugin.git"
  },
  "license": "MIT",
  "author": "Igor Kamyshev <igor@kamyshev.me>",
  "contributors": [
    {
      "name": "Mikhail Kireev",
      "url": "https://github.com/kireevmp"
    }
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "format": "prettier --write .",
    "lint": "eslint",
    "prepack": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@typescript-eslint/type-utils": "^8.59.3",
    "@typescript-eslint/utils": "^8.59.3",
    "esquery": "^1.7.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/esquery": "^1.5.4",
    "@types/estree": "^1.0.10",
    "@types/node": "~22.13.17",
    "@types/react": "^19.3.0",
    "@typescript-eslint/rule-tester": "^8.73.0",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "@vitest/coverage-v8": "^5.1.0",
    "effector": "^23.4.4",
    "effector-factorio": "^1.3.0",
    "effector-react": "^23.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.10.1",
    "prettier-plugin-embed": "^0.8.2",
    "tsdown": "0.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0",
    "typescript": ">=5.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
